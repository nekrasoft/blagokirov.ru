IndexIgnore *
Options +FollowSymlinks
Options -Indexes

RewriteEngine On
ErrorDocument 404 /404.php

# Единая каноническая версия: HTTPS + основной хост.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^blagokirov\.ru$ [NC]
RewriteRule ^ https://blagokirov.ru%{REQUEST_URI} [R=301,L]

# Дубли главной должны 301-редиректить на корень.
RewriteRule ^index(?:2)?\.php$ https://blagokirov.ru/ [R=301,L,NC]
RewriteRule ^index\.htm(?:l)?$ https://blagokirov.ru/ [R=301,L,NC]

# Для продвигаемых разделов закрепляем версию со слэшем в конце URL.
RewriteRule ^(vyvoz-musora|demontazh-postroek|arenda-kontejnerov|raschistka-uchastka|uslugi|ceny|dlya-biznesa|dokumenty|rekvizity|vyvoz-stroitelnogo-musora-v-kirove|arenda-kontejnera-8m3-v-kirove|demontazh-i-vyvoz-musora|vyvoz-musora-dlya-uk-i-tszh|vyvoz-musora-dlya-zastroyshchikov|vyvoz-musora-dlya-podryadchikov|vyvoz-musora-dlya-predpriyatiy)$ https://blagokirov.ru/$1/ [R=301,L,NC,NE]

# 301 редиректы для старых URL документов из корня в /docs/
# Используем THE_REQUEST (ASCII-only), чтобы избежать проблем с декодированием URI.
RewriteCond %{THE_REQUEST} \s/+%D0%9A%D0%9F%20%D0%91%D0%BB%D0%B0%D0%B3%D0%BE%D1%81%D0%B5%D1%80%D0%B2%D0%B8%D1%81\.pdf(?:\s|\?) [NC]
RewriteRule ^ https://blagokirov.ru/docs/КП-Благосервис.pdf [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+%D0%9C%D0%B8%D0%BD%D0%B8-%D0%BF%D1%80%D0%B5%D0%B7%D0%B5%D0%BD%D1%82%D0%B0%D1%86%D0%B8%D1%8F%20%D0%91%D0%BB%D0%B0%D0%B3%D0%BE%D1%81%D0%B5%D1%80%D0%B2%D0%B8%D1%81\.pdf(?:\s|\?) [NC]
RewriteRule ^ https://blagokirov.ru/docs/Мини-презентация-Благосервис.pdf [R=301,L,NE]

# Настройки PHP
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300

# Кодировка по умолчанию
AddDefaultCharset UTF-8

# Защита от просмотра файлов конфигурации
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|config\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Блок WordPress удален: catch-all правило создавало soft-404
# (любые несуществующие URL отдавались с кодом 200).





